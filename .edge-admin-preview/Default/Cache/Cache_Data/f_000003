    function loadSectionData(sectionId) {
      if (sectionId === 'sellers') return loadSellers();
      if (sectionId === 'products') return loadProducts();
      if (sectionId === 'orders') return loadOrders();
      return Promise.resolve();
    }

    // ============== NAVIGATION ============== 
    function switchSection(sectionId) {
      const sections = document.querySelectorAll('.dashboard-section');
      sections.forEach(section => section.classList.remove('active'));
      document.getElementById(sectionId).classList.add('active');

      document.querySelectorAll('.sidebar-nav-link').forEach(link => {
        link.classList.remove('active');
      });
      document.querySelector(`[data-section="${sectionId}"]`).classList.add('active');

      const titleMap = {
        overview: 'Platform Overview',
        sellers: 'Seller Management',
        products: 'Product Management',
        orders: 'Order Management',
        customers: 'Customer Management',
        payments: 'Platform Payments',
        payouts: 'Seller Payouts',
        content: 'Content & Homepage',
        analytics: 'Analytics & Insights',
        support: 'Support Center',
        settings: 'Platform Settings'
      };
      document.getElementById('headerTitle').textContent = titleMap[sectionId];

      if (window.innerWidth <= 768) {
        document.getElementById('sidebar').classList.add('mobile-hidden');
      }
    }

    function applyInitialAdminSection() {
      const params = new URLSearchParams(window.location.search);
      const requestedSection = params.get('section') ||
        sessionStorage.getItem('fr_admin_preview_section') ||
        window.location.hash.replace('#', '') ||
        'overview';

      if (!requestedSection || requestedSection === 'overview' || !document.getElementById(requestedSection)) {
        sessionStorage.removeItem('fr_admin_preview_section');
        return;
      }

      switchSection(requestedSection);
      loadSectionData(requestedSection);
      sessionStorage.removeItem('fr_admin_preview_section');
    }

    // ============== TABS ============== 
    function switchTab(tabId, event) {
      event?.preventDefault();
      const tabButton = event?.target;
      const tabsContainer = tabButton?.closest('.tabs');
      
      if (tabsContainer) {
        const allTabContents = tabsContainer.parentElement.querySelectorAll('.tab-content');
        allTabContents.forEach(tab => tab.classList.remove('active'));
        const allButtons = tabsContainer.querySelectorAll('.tab-button');
        allButtons.forEach(btn => btn.classList.remove('active'));
        document.getElementById(tabId).classList.add('active');
        tabButton.classList.add('active');
      }
    }

    // ============== SIDEBAR & HEADER ============== 
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('mobile-hidden');
      document.getElementById('sidebar').classList.toggle('mobile-visible');
    }

    function toggleProfileDropdown() {
      document.getElementById('profileMenu').classList.toggle('active');
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.profile-dropdown')) {
        document.getElementById('profileMenu').classList.remove('active');
      }
    });

    // ============== ACTION HANDLERS ============== 
    function viewSeller(id) { 
      const seller = window.sellers?.find(s => s.id === id);
      openInfoPanel(
        'Seller details',
        `Store: ${seller?.storeName || 'Unknown'}\nEmail: ${seller?.email || 'Not available'}\nStatus: ${seller?.status || 'Unknown'}\nRating: ${seller?.rating || 'Not rated'}`,
        'info'
      );
    }
    
    async function approveSeller(id) { 
      try {
        await api.updateSellerStatus(id, 'Active');
        showPageToast('Seller approved successfully.', 'success', 'Seller updated');
        await loadSellers();
      } catch (error) {
        showPageToast('Failed: ' + error.message, 'error', 'Seller update failed', 6000);
      }
    }
    
    async function rejectSeller(id) { 
      try {
        await api.updateSellerStatus(id, 'Rejected');
        showPageToast('Seller rejected successfully.', 'warning', 'Seller updated');
        await loadSellers();
      } catch (error) {
        showPageToast('Failed: ' + error.message, 'error', 'Seller update failed', 6000);
      }
    }
    
    function editCommission(id) {
      openInfoPanel('Commission controls', 'Edit commission for seller #' + id + ' from this dashboard section.', 'info');
    }
    
    function viewProduct(id) { 
      const product = window.products?.find(p => p.id === id);
      openInfoPanel(
        'Product details',
        `Product: ${product?.name || 'Unknown'}\nPrice: INR ${product?.price ?? 'N/A'}\nStock: ${product?.stock ?? 'N/A'}\nStatus: ${product?.status || 'Unknown'}`,
        'info'
