  <script>
    let pageActionConfig = null;

    function escapeHtml(value) {
      const entityMap = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      };
      return String(value == null ? '' : value).replace(/[&<>"']/g, (character) => entityMap[character]);
    }

    function getPageActionElements() {
      return {
        card: document.getElementById('pageActionCard'),
        kicker: document.getElementById('pageActionKicker'),
        title: document.getElementById('pageActionTitle'),
        message: document.getElementById('pageActionMessage'),
        fields: document.getElementById('pageActionFields'),
        cancelBtn: document.getElementById('pageActionCancelBtn'),
        confirmBtn: document.getElementById('pageActionConfirmBtn')
      };
    }

    function removePageToast(toast) {
      if (toast && toast.parentNode) {
        toast.parentNode.removeChild(toast);
      }
    }

    function showPageToast(message, tone = 'info', title = 'Notice', timeoutMs = 4200) {
      const stack = document.getElementById('pageToastStack');
      if (!stack) {
        return;
      }

      const toast = document.createElement('article');
      toast.className = `page-toast ${tone}`;
      toast.innerHTML = `
        <div class="page-toast-header">
          <strong class="page-toast-title">${escapeHtml(title)}</strong>
          <button class="page-toast-close" type="button" aria-label="Dismiss notice">x</button>
        </div>
        <div class="page-toast-message">${escapeHtml(message)}</div>
      `;

      const closeBtn = toast.querySelector('.page-toast-close');
      closeBtn.addEventListener('click', () => removePageToast(toast));
      stack.prepend(toast);

      if (timeoutMs > 0) {
        window.setTimeout(() => removePageToast(toast), timeoutMs);
      }
    }

    function hidePageAction() {
      const elements = getPageActionElements();
      pageActionConfig = null;
      elements.card.hidden = true;
      elements.card.className = 'page-action-card warning';
      elements.fields.innerHTML = '';
      elements.cancelBtn.hidden = false;
      elements.confirmBtn.disabled = false;
      elements.confirmBtn.textContent = 'Continue';
    }

    function dismissPageAction() {
      hidePageAction();
    }

    function cancelPageAction() {
      const config = pageActionConfig;
      hidePageAction();
      if (config && typeof config.onCancel === 'function') {
        config.onCancel();
      }
    }

    function openPageAction(options = {}) {
      const elements = getPageActionElements();
      const tone = options.tone || 'warning';
      const defaultKicker = {
        info: 'On-page notice',
        success: 'Saved',
        warning: 'Action needed',
        error: 'Attention needed'
      };

      pageActionConfig = options;
      elements.card.className = `page-action-card ${tone}`;
      elements.kicker.textContent = options.kicker || defaultKicker[tone] || 'On-page notice';
      elements.title.textContent = options.title || 'Confirm this change';
      elements.message.textContent = options.message || '';
      elements.fields.innerHTML = options.fieldsHtml || '';
      elements.cancelBtn.hidden = options.showCancel === false;
      elements.cancelBtn.textContent = options.cancelText || 'Cancel';
      elements.confirmBtn.textContent = options.confirmText || 'Continue';
      elements.card.hidden = false;

      if (typeof options.onOpen === 'function') {
        window.requestAnimationFrame(() => options.onOpen());
      }
    }

    async function confirmPageAction() {
      const config = pageActionConfig;
      const elements = getPageActionElements();
      if (!config) {
        return;
      }

      const originalText = elements.confirmBtn.textContent;
      elements.confirmBtn.disabled = true;
      if (config.pendingText) {
        elements.confirmBtn.textContent = config.pendingText;
      }

      try {
        const payload = typeof config.getPayload === 'function' ? config.getPayload() : undefined;
        if (payload === false) {
          elements.confirmBtn.disabled = false;
          elements.confirmBtn.textContent = originalText;
          return;
        }

        if (typeof config.onConfirm === 'function') {
          await config.onConfirm(payload);
        }

        hidePageAction();
      } catch (error) {
        elements.confirmBtn.disabled = false;
        elements.confirmBtn.textContent = originalText;
        showPageToast(error.message || 'Something went wrong.', 'error', 'Action failed', 6000);
      }
    }

    function openInfoPanel(title, message, tone = 'info') {
      openPageAction({
        tone,
        title,
        message,
        confirmText: 'Close',
        showCancel: false
      });
    }

    // ============== AUTHENTICATION ============== 
    async function checkAdminAuth() {
      const auth = api.getAuth();
      if (!auth.token) {
        document.getElementById('loginModal').classList.add('active');
        return false;
      }
      document.getElementById('loginModal').classList.remove('active');
      updateAdminProfile();
      loadAdminDashboard();
      applyInitialAdminSection();
      return true;
    }

    async function performAdminLogin() {
      const email = document.getElementById('loginEmail').value;
      const password = document.getElementById('loginPassword').value;
      const errorDiv = document.getElementById('loginError');

      if (!email || !password) {
        errorDiv.textContent = 'Email and password required';
        errorDiv.style.display = 'block';
        return;
      }

      try {
        errorDiv.style.display = 'none';
        await api.adminLogin({ email, password });
        document.getElementById('loginModal').classList.remove('active');
        updateAdminProfile();
        loadAdminDashboard();
        applyInitialAdminSection();
      } catch (error) {
        errorDiv.textContent = error.message || 'Login failed';
        errorDiv.style.display = 'block';
      }
    }

    function updateAdminProfile() {
      const user = api.getAuth().user;
      if (user) {
        document.querySelector('.profile-avatar').textContent = 'AD';
        document.querySelector('.profile-name').textContent = 'Admin';
      }
    }

    async function loadAdminDashboard() {
      try {
        const dashboardData = await api.getAdminDashboard();
        updateAdminMetrics(dashboardData.data);
      } catch (error) {
        console.error('Failed to load admin dashboard:', error);
      }
    }

    function updateAdminMetrics(data) {
      if (data.metrics) {
        const metrics = data.metrics;
        const metricElements = document.querySelectorAll('.metric-value');
        metricElements[0].textContent = '₹' + (metrics.totalRevenue / 1000000).toFixed(1) + 'M';
        metricElements[1].textContent = metrics.totalOrders;
        metricElements[2].textContent = metrics.totalCustomers;
        metricElements[3].textContent = metrics.totalSellers;
        metricElements[4].textContent = metrics.totalProducts;
        metricElements[5].textContent = '₹' + (metrics.totalRevenue * 0.14 / 1000000).toFixed(1) + 'M';
        metricElements[6].textContent = '87';
        metricElements[7].textContent = metrics.pendingSellers;
      }
    }

    async function loadSellers() {
      try {
        const response = await api.getAllSellers();
        window.sellers = response.data || [];
        refreshSellersTable();
      } catch (error) {
        console.error('Failed to load sellers:', error);
      }
    }

    function refreshSellersTable() {
      const tbody = document.querySelectorAll('table tbody')[0];
      if (!tbody) return;
      tbody.innerHTML = '';
      window.sellers.slice(0, 3).forEach(seller => {
        const row = `
          <tr>
            <td><strong>${seller.storeName}</strong></td>
            <td>${seller.email}</td>
            <td>${seller.products?.length || 0}</td>
            <td>${seller.totalOrders}</td>
            <td>${seller.rating || 4.5}★</td>
            <td><span class="badge ${seller.kycStatus === 'Verified' ? 'success' : ''}">${seller.kycStatus === 'Verified' ? '✓' : 'Pending'}</span></td>
            <td><span class="status-badge status-${seller.status.toLowerCase()}">${seller.status}</span></td>
            <td>
              <div class="action-buttons">
                <button class="action-btn" onclick="viewSeller('${seller.id}')">View</button>
                ${seller.status === 'Pending' ? `<button class="action-btn success" onclick="approveSeller('${seller.id}')">Approve</button>` : ''}
              </div>
            </td>
          </tr>
        `;
        tbody.insertAdjacentHTML('beforeend', row);
      });
    }

    async function loadProducts() {
      try {
        const response = await api.getAllProducts();
        window.products = response.data || [];
        refreshProductsTable();
      } catch (error) {
        console.error('Failed to load products:', error);
      }
    }

    function refreshProductsTable() {
      const tbody = document.querySelectorAll('table tbody')[1];
      if (!tbody) return;
      tbody.innerHTML = '';
      window.products.slice(0, 3).forEach(product => {
        const row = `
          <tr>
            <td><strong>${product.name}</strong></td>
            <td>${product.sellerName}</td>
            <td>${product.category}</td>
            <td>₹${product.price}</td>
            <td>${product.stock}</td>
            <td><span class="status-badge status-${product.status.toLowerCase().replace(' ', '-')}">${product.status}</span></td>
