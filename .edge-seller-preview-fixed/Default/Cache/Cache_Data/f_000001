    async function editOrderStatus(id) {
      const statuses = ['Pending', 'Processing', 'Shipped', 'Delivered', 'Cancelled'];
      const currentOrder = window.sellerOrders?.find(order => order.id === id);
      openPageAction({
        tone: 'info',
        title: 'Update order status',
        message: `Choose the next status for order ${id}.`,
        confirmText: 'Save status',
        pendingText: 'Saving...',
        fieldsHtml: `
          <div class="page-action-field">
            <label for="pageOrderStatusInput">Order status</label>
            <select id="pageOrderStatusInput" class="page-action-input">
              ${statuses.map((status) => `<option value="${escapeHtml(status)}"${currentOrder?.status === status ? ' selected' : ''}>${escapeHtml(status)}</option>`).join('')}
            </select>
          </div>
        `,
        getPayload: () => {
          const selectedStatus = document.getElementById('pageOrderStatusInput')?.value || '';
          if (!statuses.includes(selectedStatus)) {
            showPageToast('Select a valid order status before saving.', 'warning', 'Status required');
            return false;
          }
          return selectedStatus;
        },
        onConfirm: async (selectedStatus) => {
          await api.updateOrderStatus(id, selectedStatus);
          showPageToast('Order status updated successfully.', 'success', 'Status saved');
          await loadSellerOrders();
        }
      });
    }

    async function editStock(id) {
      const product = window.sellerProducts?.find(item => item.id === id);
      openPageAction({
        tone: 'warning',
        title: 'Adjust stock level',
        message: `Enter the new stock quantity for ${product?.name || 'this product'}.`,
        confirmText: 'Update stock',
        pendingText: 'Updating...',
        fieldsHtml: `
          <div class="page-action-field">
            <label for="pageStockInput">New stock quantity</label>
            <input id="pageStockInput" class="page-action-input" type="number" min="0" step="1" value="${escapeHtml(product?.stock ?? 0)}">
          </div>
        `,
        getPayload: () => {
          const rawValue = document.getElementById('pageStockInput')?.value || '';
          const nextStock = Number(rawValue);
          if (!rawValue || Number.isNaN(nextStock) || nextStock < 0 || !Number.isInteger(nextStock)) {
            showPageToast('Enter a valid stock quantity before saving.', 'warning', 'Invalid stock');
            return false;
          }
          return nextStock;
        },
        onConfirm: async (nextStock) => {
          await api.updateProduct(id, { stock: nextStock });
          showPageToast('Stock updated successfully.', 'success', 'Inventory updated');
          await loadSellerProducts();
        }
      });
    }

    async function saveProduct() {
      const modal = document.getElementById('addProductModal');
      const editId = modal.getAttribute('data-edit-id');
      const price = Number(document.getElementById('productPrice').value);
      const discountPriceRaw = document.getElementById('productDiscountPrice').value;
      const stock = Number(document.getElementById('productStock').value);
      const status = document.getElementById('productStatus').value || 'Active';
      const sizes = (document.getElementById('productSizes').value || '')
        .split(',')
        .map(value => value.trim())
        .filter(Boolean);
      const colors = (document.getElementById('productColors').value || '')
        .split(',')
        .map(value => value.trim())
        .filter(Boolean);
      const productData = {
        name: document.getElementById('productName').value.trim(),
        category: document.getElementById('productCategory').value,
        brand: document.getElementById('productBrand')?.value || 'Fresh Republic',
        price,
        discountPrice: discountPriceRaw ? Number(discountPriceRaw) : price,
        stock: Number.isFinite(stock) ? stock : 0,
        description: document.getElementById('productDescription').value.trim(),
        image: document.getElementById('productImage').value.trim(),
        sku: document.getElementById('productSku').value.trim(),
        sizes,
        colors,
        status,
        intent: status === 'Draft' ? 'draft' : 'publish'
      };

      if (!productData.name || !productData.category || !Number.isFinite(productData.price) || productData.price <= 0) {
        showPageToast('Please fill all required product fields before saving.', 'warning', 'Missing details');
        return;
      }

      if (!Number.isFinite(productData.stock) || productData.stock < 0) {
        showPageToast('Enter a valid stock quantity before saving.', 'warning', 'Invalid stock');
        return;
      }

      try {
        if (editId) {
          await api.updateProduct(editId, productData);
          showPageToast('Product updated successfully.', 'success', 'Changes saved');
        } else {
          await api.createProduct(productData);
          showPageToast('Product created successfully.', 'success', 'Product added');
        }
        closeModal('addProductModal');
        await loadSellerProducts();
      } catch (error) {
        showPageToast('Failed to save product: ' + error.message, 'error', 'Save failed', 6000);
      }
    }

