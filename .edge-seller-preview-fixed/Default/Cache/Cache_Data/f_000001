  <script>
    // ============== NAVIGATION ============== 
    function switchSection(sectionId) {
      // Hide all sections
      const sections = document.querySelectorAll('.dashboard-section');
      sections.forEach(section => section.classList.remove('active'));

      // Show selected section
      document.getElementById(sectionId).classList.add('active');

      // Update sidebar active state
      document.querySelectorAll('.sidebar-nav-link').forEach(link => {
        link.classList.remove('active');
      });
      document.querySelector(`[data-section="${sectionId}"]`).classList.add('active');

      // Update header title
      const titleMap = {
        dashboard: 'Dashboard Overview',
        products: 'Product Management',
        orders: 'Order Management',
        inventory: 'Inventory Management',
        earnings: 'Earnings & Payments',
        profile: 'Seller Profile',
        analytics: 'Analytics & Performance',
        support: 'Support & Help'
      };
      document.getElementById('headerTitle').textContent = titleMap[sectionId];
      if (window.location.hash !== `#${sectionId}`) {
        history.replaceState(null, '', `#${sectionId}`);
      }
      window.scrollTo(0, 0);

      // Close sidebar on mobile
      if (window.innerWidth <= 768) {
        document.getElementById('sidebar').classList.add('mobile-hidden');
      }
    }

    function applyInitialSection() {
      const previewSection = sessionStorage.getItem('fr_preview_section');
      if (previewSection) {
        sessionStorage.removeItem('fr_preview_section');
        if (document.getElementById(previewSection)?.classList.contains('dashboard-section')) {
          switchSection(previewSection);
          return;
        }
      }

      const sectionId = (window.location.hash || '').replace('#', '');
      if (sectionId && document.getElementById(sectionId)?.classList.contains('dashboard-section')) {
        switchSection(sectionId);
      }
    }

    // ============== TABS ============== 
    function switchTab(tabId, event) {
      event?.preventDefault();
      
      // Find the tab container
      const tabButton = event?.target;
      const tabsContainer = tabButton?.closest('.tabs');
      
      if (tabsContainer) {
        // Hide all tabs in this container
        const allTabContents = tabsContainer.parentElement.querySelectorAll('.tab-content');
        allTabContents.forEach(tab => tab.classList.remove('active'));

        // Deactivate all buttons in this container
        const allButtons = tabsContainer.querySelectorAll('.tab-button');
        allButtons.forEach(btn => btn.classList.remove('active'));

        // Activate selected tab and button
        document.getElementById(tabId).classList.add('active');
        tabButton.classList.add('active');
      }
    }

    function annotateResponsiveTables() {
      document.querySelectorAll('.table-responsive table').forEach((table) => {
        const headers = Array.from(table.querySelectorAll('thead th')).map((header) => header.textContent.trim());
        if (!headers.length) {
          return;
        }

        table.querySelectorAll('tbody tr').forEach((row) => {
          Array.from(row.children).forEach((cell, index) => {
            if (cell.tagName === 'TD') {
              cell.setAttribute('data-label', headers[index] || '');
            }
          });
        });
      });
    }

    // ============== MODALS ============== 
    function resetAddProductForm() {
      const defaults = {
        productName: '',
        productCategory: 'Jeans',
        productBrand: 'Fresh Republic',
        productPrice: '',
        productDiscountPrice: '',
        productSizes: '',
        productColors: '',
        productStock: '',
        productSku: '',
        productStatus: 'Active',
        productImage: '',
        productDescription: ''
      };

      Object.entries(defaults).forEach(([fieldId, fieldValue]) => {
        const field = document.getElementById(fieldId);
        if (field) {
          field.value = fieldValue;
        }
      });

      const modal = document.getElementById('addProductModal');
      modal?.removeAttribute('data-edit-id');
      const title = modal?.querySelector('.modal-title');
      if (title) {
        title.textContent = 'Add New Product';
      }
    }

    function openAddProductModal() {
      const modal = document.getElementById('addProductModal');
      if (!modal.getAttribute('data-edit-id')) {
        resetAddProductForm();
      }
      modal.classList.add('active');
    }

    function openBulkUpdateModal() {
      document.getElementById('bulkUpdateModal').classList.add('active');
    }

    function openTicketModal() {
      document.getElementById('ticketModal').classList.add('active');
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      modal.classList.remove('active');
      if (modalId === 'addProductModal') {
        window.setTimeout(() => resetAddProductForm(), 150);
      }
    }

    // Close modal when clicking outside
    window.addEventListener('click', (e) => {
      if (e.target.classList.contains('modal')) {
        e.target.classList.remove('active');
      }
    });

    // ============== SIDEBAR & HEADER ============== 
    function toggleSidebar() {
      const sidebar = document.getElementById('sidebar');
      const mainContent = document.getElementById('mainContent');
      const header = document.getElementById('header');

      sidebar.classList.toggle('mobile-hidden');
      sidebar.classList.toggle('mobile-visible');
    }

    // ============== AUTHENTICATION ============== 
    function getSellerLoginUrl() {
      return 'seller-login.html?redirect=' + encodeURIComponent('seller-dashboard.html');
    }

    function redirectToSellerLogin() {
      window.location.href = getSellerLoginUrl();
    }

    let pageActionConfig = null;

    function escapeHtml(value) {
      const entityMap = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      };
      return String(value == null ? '' : value).replace(/[&<>"']/g, (character) => entityMap[character]);
    }

    function getPageActionElements() {
      return {
        card: document.getElementById('pageActionCard'),
        kicker: document.getElementById('pageActionKicker'),
        title: document.getElementById('pageActionTitle'),
        message: document.getElementById('pageActionMessage'),
        fields: document.getElementById('pageActionFields'),
        cancelBtn: document.getElementById('pageActionCancelBtn'),
        confirmBtn: document.getElementById('pageActionConfirmBtn')
      };
    }

    function removePageToast(toast) {
      if (toast && toast.parentNode) {
        toast.parentNode.removeChild(toast);
      }
    }

    function showPageToast(message, tone = 'info', title = 'Notice', timeoutMs = 4200) {
      const stack = document.getElementById('pageToastStack');
      if (!stack) {
        return;
      }

      const toast = document.createElement('article');
      toast.className = `page-toast ${tone}`;
      toast.innerHTML = `
        <div class="page-toast-header">
          <strong class="page-toast-title">${escapeHtml(title)}</strong>
          <button class="page-toast-close" type="button" aria-label="Dismiss notice">x</button>
        </div>
        <div class="page-toast-message">${escapeHtml(message)}</div>
      `;

      const closeBtn = toast.querySelector('.page-toast-close');
      closeBtn.addEventListener('click', () => removePageToast(toast));
      stack.prepend(toast);

      if (timeoutMs > 0) {
        window.setTimeout(() => removePageToast(toast), timeoutMs);
      }
    }

    function hidePageAction() {
      const elements = getPageActionElements();
      pageActionConfig = null;
      elements.card.hidden = true;
      elements.card.className = 'page-action-card warning';
      elements.fields.innerHTML = '';
      elements.cancelBtn.hidden = false;
      elements.confirmBtn.disabled = false;
      elements.confirmBtn.textContent = 'Continue';
    }

    function dismissPageAction() {
      hidePageAction();
    }

    function cancelPageAction() {
      const config = pageActionConfig;
      hidePageAction();
      if (config && typeof config.onCancel === 'function') {
        config.onCancel();
      }
    }

    function openPageAction(options = {}) {
      const elements = getPageActionElements();
      const tone = options.tone || 'warning';
      const defaultKicker = {
        info: 'On-page notice',
        success: 'Saved',
        warning: 'Action needed',
        error: 'Attention needed'
      };

      pageActionConfig = options;
      elements.card.className = `page-action-card ${tone}`;
      elements.kicker.textContent = options.kicker || defaultKicker[tone] || 'On-page notice';
      elements.title.textContent = options.title || 'Confirm this change';
      elements.message.textContent = options.message || '';
      elements.fields.innerHTML = options.fieldsHtml || '';
      elements.cancelBtn.hidden = options.showCancel === false;
      elements.cancelBtn.textContent = options.cancelText || 'Cancel';
      elements.confirmBtn.textContent = options.confirmText || 'Continue';
      elements.card.hidden = false;

      if (typeof options.onOpen === 'function') {
        window.requestAnimationFrame(() => options.onOpen());
      }
    }

    async function confirmPageAction() {
      const config = pageActionConfig;
      const elements = getPageActionElements();
      if (!config) {
        return;
      }

      const originalText = elements.confirmBtn.textContent;
      elements.confirmBtn.disabled = true;
      if (config.pendingText) {
        elements.confirmBtn.textContent = config.pendingText;
      }

      try {
        const payload = typeof config.getPayload === 'function' ? config.getPayload() : undefined;
        if (payload === false) {
          elements.confirmBtn.disabled = false;
          elements.confirmBtn.textContent = originalText;
          return;
        }

        if (typeof config.onConfirm === 'function') {
          await config.onConfirm(payload);
        }

        hidePageAction();
      } catch (error) {
        elements.confirmBtn.disabled = false;
        elements.confirmBtn.textContent = originalText;
        showPageToast(error.message || 'Something went wrong.', 'error', 'Action failed', 6000);
      }
    }

    function openInfoPanel(title, message, tone = 'info') {
      openPageAction({
        tone,
        title,
        message,
        confirmText: 'Close',
        showCancel: false
      });
    }

    function checkAuthentication() {
      if (!window.api || typeof window.api.getAuth !== 'function') {
        redirectToSellerLogin();
        return false;
      }

      const auth = window.api.getAuth();
      if (!auth.token || auth.role !== 'seller') {
        if (typeof window.api.logout === 'function') {
          window.api.logout();
        }
        redirectToSellerLogin();
        return false;
      }
      updateProfileName();
      loadDashboardData();
      return true;
    }

    function updateProfileName() {
      const user = api.getAuth().user;
      if (user) {
        const initials = (user.name || user.storeName || 'S').split(' ').map(n => n[0]).join('').toUpperCase();
        document.querySelector('.profile-avatar').textContent = initials;
        document.querySelector('.profile-name').textContent = user.storeName || user.name || 'Seller';
      }
    }

    // ============== DATA LOADING ============== 
    async function loadDashboardData() {
      try {
        await Promise.all([
          api.getSellerDashboard().then((dashboardData) => {
            updateDashboardMetrics(dashboardData.data);
          }),
          loadSellerProducts(),
          loadSellerOrders()
        ]);
      } catch (error) {
        console.error('Failed to load dashboard:', error);
        const message = String(error?.message || '');
        if (/HTTP 401|HTTP 403|invalid token|access denied|jwt/i.test(message)) {
          if (window.api && typeof window.api.logout === 'function') {
            window.api.logout();
          }
          redirectToSellerLogin();
        }
      }
    }

    function updateDashboardMetrics(data) {
      if (data.metrics) {
        document.querySelectorAll('.metric-value').forEach((el, i) => {
          const values = [
            data.metrics.totalRevenue,
            data.metrics.totalOrders,
            data.metrics.totalEarnings,
            data.metrics.totalProducts
          ];
          if (i < values.length) {
            el.textContent = values[i].toString().includes('.') ? 
              '₹' + values[i].toLocaleString('en-IN') : 
              values[i];
          }
        });
      }
    }

    async function loadSellerProducts() {
      try {
        const response = await api.getMyProducts();
        window.sellerProducts = response.data || [];
        refreshProductsTable();
      } catch (error) {
        console.error('Failed to load products:', error);
      }
    }

    function refreshProductsTable() {
      const tbody = document.querySelector('#sellerProductsTable tbody');
      if (!tbody) return;

      tbody.innerHTML = '';
      window.sellerProducts.forEach(product => {
        const row = `
          <tr>
            <td><strong>${product.name}</strong></td>
            <td>${product.category}</td>
            <td>₹${product.price}</td>
            <td>${product.stock}</td>
            <td>${product.totalSold || 0}</td>
            <td><span class="status-badge status-${product.status.toLowerCase().replace(' ', '-')}">${product.status}</span></td>
            <td>
              <div class="action-buttons">
                <button class="action-btn" onclick="editProduct('${product.id}')">Edit</button>
                <button class="action-btn danger" onclick="deleteProduct('${product.id}')">Delete</button>
              </div>
            </td>
          </tr>
        `;
        tbody.insertAdjacentHTML('beforeend', row);
      });
      annotateResponsiveTables();
    }

    async function loadSellerOrders() {
      try {
        const response = await api.getSellerOrders();
        window.sellerOrders = response.data || [];
        refreshOrdersTable();
      } catch (error) {
        console.error('Failed to load orders:', error);
      }
    }

    function refreshOrdersTable() {
      const tbody = document.querySelector('#sellerOrdersTable tbody');
      if (!tbody) return;

      tbody.innerHTML = '';
      window.sellerOrders.forEach(order => {
        const row = `
          <tr>
            <td>${order.id}</td>
            <td>${order.customerName}</td>
            <td>₹${order.totalAmount}</td>
            <td>${order.items.length}</td>
            <td><span class="status-badge status-${order.status.toLowerCase()}">${order.status}</span></td>
            <td>${new Date(order.placedAt).toLocaleDateString()}</td>
            <td>
              <div class="action-buttons">
                <button class="action-btn" onclick="viewOrder('${order.id}')">View</button>
                <button class="action-btn" onclick="editOrderStatus('${order.id}')">Update</button>
              </div>
            </td>
          </tr>
        `;
